        <!-- s5b: Loop-back arrow (从 Loop 底端 → 弯到左侧 → 回到 Loop 顶端) -->
        <mxCell id="s5b" parent="1" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2.5;dashed=1;curved=1;" edge="1">
