            <mxPoint x="135" y="800" as="sourcePoint" />
            <mxPoint x="135" y="115" as="targetPoint" />
            <Array as="points">
              <mxPoint x="40" y="800" />
              <mxPoint x="40" y="115" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s5b_l" parent="1" style="text;html=1;align=center;fontSize=10;fontColor=#82b366;fontStyle=1;" value="↺ 续轮" vertex="1">
          <mxGeometry height="14" width="50" x="15" y="450" as="geometry" />
        </mxCell>

        <!-- ============ FOOTER NOTES ============ -->
        <mxCell id="footer1" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;" value="关键不变量:① 模型只能「请求」工具,运行时才「执行」  ·  ② 每次状态转移必有 reason  ·  ③ 工具失败用「错误标记」而非抛异常,Step 4 这条流水线永远完整跑完" vertex="1">
          <mxGeometry height="20" width="1280" x="20" y="820" as="geometry" />
